---
/**
 * AdSlot — Google AdSense ad slot.
 * Currently hidden until AdSense approval is granted.
 * To activate: replace the comment block below with real <ins> AdSense tags.
 */
interface Props {
  position: 'top' | 'sidebar' | 'inline' | 'bottom';
  format?: 'horizontal' | 'vertical' | 'rectangle' | 'auto';
}

const { position, format = 'auto' } = Astro.props;
---

<div
  class={`ad-slot ad-slot--${position}`}
  data-ad-position={position}
  data-ad-format={format}
  aria-hidden="true"
>
  <!--
    ADSENSE PLACEHOLDER – hidden until approval.
    Replace this comment with your real AdSense <ins> tag after approval:

    <ins class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-3019636938770543"
      data-ad-slot="XXXXXXXXXX"
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  -->
</div>

<style>
  .ad-slot {
    display: none;
  }

  /* Un-hide and style once real ads are inserted */
  .ad-slot:has(ins.adsbygoogle) {
    display: block;
  }

  .ad-slot--top {
    margin-bottom: var(--space-6);
  }

  .ad-slot--sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .ad-slot--inline {
    margin-block: var(--space-6);
  }

  .ad-slot--bottom {
    margin-top: var(--space-8);
  }
</style>
