---
import '@adsites/ui-kit/styles/global.css';
import '@adsites/ui-kit/styles/tool-page.css';
import Header from '@adsites/ui-kit/Header.astro';
import Footer from '@adsites/ui-kit/Footer.astro';
import AdSlot from '@adsites/ui-kit/AdSlot.astro';
import CookieConsent from '@adsites/ui-kit/CookieConsent.astro';
import { SITE, TOOLS } from '../config';

interface Props {
  title: string;
  description: string;
  date: string;
  readingTime: number;
  canonicalPath: string;
}

const { title, description, date, readingTime, canonicalPath } = Astro.props;
const fullTitle = `${title} — ${SITE.name}`;
const canonical = `${SITE.url}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description,
      url: canonical,
      datePublished: date,
      publisher: {
        "@type": "Organization",
        name: SITE.name,
        url: SITE.url,
      },
    })} />

    <!-- Google AdSense -->
    {SITE.adsenseClientId && (
      <>
        <meta name="google-adsense-account" content={SITE.adsenseClientId} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClientId}`}
          crossorigin="anonymous"
        />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Georgia:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />

    <script is:inline>
      (function() {
        try {
          const t = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', t);
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header siteName={SITE.name} siteUrl={SITE.url} tools={TOOLS} />

    <main class="blog-post-page">
      <div class="blog-container">
        <article class="blog-article">
          <header class="article-header">
            <div class="article-breadcrumb">
              <a href="/blog">← Back to Blog</a>
            </div>
            <h1 class="article-title">{title}</h1>
            <div class="article-meta">
              <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <span class="meta-divider">·</span>
              <span>{readingTime} min read</span>
            </div>
          </header>

          <AdSlot position="top" />

          <div class="article-body">
            <slot />
          </div>

          <footer class="article-footer">
            <div class="article-cta">
              <p>Ready to try it yourself?</p>
              <a href="/tools" class="cta-btn">Browse All Free Tools →</a>
            </div>
          </footer>
        </article>
      </div>
    </main>

    <AdSlot position="bottom" />
    <Footer siteName={SITE.name} siteUrl={SITE.url} />
    <CookieConsent />
  </body>
</html>

<style>
  .blog-post-page {
    padding: var(--space-8) 0 var(--space-16);
  }

  .blog-container {
    max-width: 800px;
    margin-inline: auto;
    padding: 0 var(--space-4);
  }

  .article-breadcrumb {
    margin-bottom: var(--space-6);
  }

  .article-breadcrumb a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-4);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .meta-divider {
    opacity: 0.5;
  }

  /* Article body typography */
  .article-body {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  .article-body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  .article-body :global(h3) {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .article-body :global(strong) {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .article-body :global(code) {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    color: var(--color-accent);
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
    background: var(--color-bg-secondary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .article-body :global(th) {
    background: var(--color-bg-secondary);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .article-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .article-cta {
    text-align: center;
    padding: var(--space-8);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
  }

  .article-cta p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
  }

  .cta-btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent-gradient);
    color: white;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    transition: opacity var(--transition-fast);
  }

  .cta-btn:hover {
    opacity: 0.9;
    color: white;
  }
</style>
