---
import '@adsites/ui-kit/styles/global.css';
import '@adsites/ui-kit/styles/tool-page.css';
import Header from '@adsites/ui-kit/Header.astro';
import Footer from '@adsites/ui-kit/Footer.astro';
import AdSlot from '@adsites/ui-kit/AdSlot.astro';
import { SITE, TOOLS } from '../config';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About Us — {SITE.name}</title>
    <meta name="description" content={`Learn about ${SITE.name}, our mission to build fast, free, and 100% private browser-based utility tools.`} />
    <link rel="canonical" href={`${SITE.url}/about`} />

    <!-- Google AdSense -->
    {SITE.adsenseClientId && (
      <>
        <meta name="google-adsense-account" content={SITE.adsenseClientId} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClientId}`}
          crossorigin="anonymous"
        />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <Header siteName={SITE.name} siteUrl={SITE.url} tools={TOOLS} />

    <main class="about-page container">
      <header class="about-hero">
        <h1>About {SITE.name}</h1>
        <p class="hero-lead">
          Building fast, accessible, and privacy-first web utilities for writers, developers, students, and professionals worldwide.
        </p>
      </header>

      <div class="about-content">
        <section class="mission-section">
          <h2>Our Mission</h2>
          <p>
            Many online text tools today are bloated with slow scripts, invasive sign-up walls, or security risks that upload your private text to third-party servers.
          </p>
          <p>
            <strong>{SITE.name} was built with a different philosophy:</strong> zero-friction tools that run 100% locally inside your web browser. No accounts, no subscriptions, and complete privacy guaranteed. Every calculation, conversion, and transformation happens on your device — your text never leaves your browser.
          </p>
        </section>

        <section class="origin-section">
          <h2>Who Built This</h2>
          <p>
            FixMyString started as a small personal project — born out of frustration with slow, ad-heavy, privacy-invasive text tools that required an account just to reverse a string or count words.
          </p>
          <p>
            We believe that simple, useful tools should just <em>work</em> — instantly, privately, and for free. That belief turned a weekend script into a growing suite of tools that thousands of people use every day to write, code, and process text more efficiently.
          </p>
        </section>

        <section class="pillars-grid">
          <div class="pillar-card">
            <div class="pillar-icon">⚡</div>
            <h3>Instant Speed</h3>
            <p>Built with modern static web tech (Astro) so pages load in milliseconds globally via Cloudflare's CDN.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">🔒</div>
            <h3>Privacy by Design</h3>
            <p>All processing happens on your device. Your sensitive text never hits a backend server — ever.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">📱</div>
            <h3>Cross-Platform</h3>
            <p>Optimized for seamless performance on smartphones, tablets, and desktop computers.</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">🆓</div>
            <h3>Always Free</h3>
            <p>Every tool on this site is and always will be free. No accounts, no paywalls, no limitations.</p>
          </div>
        </section>

        <section class="tools-section">
          <h2>Our Tools</h2>
          <p>FixMyString offers a growing collection of browser-based text utilities. Current tools include:</p>
          <ul class="tools-list">
            <li><a href="/tools/word-counter">Word & Character Counter</a> — Count words, characters, sentences, paragraphs, and estimate reading time.</li>
            <li><a href="/tools/case-converter">Case Converter</a> — Convert text between uppercase, lowercase, title case, sentence case, camelCase, and more.</li>
            <li><a href="/tools/text-reverser">Text Reverser</a> — Reverse characters, words, lines, or flip text upside down with Unicode.</li>
            <li><a href="/tools/lorem-ipsum">Lorem Ipsum Generator</a> — Generate authentic Lorem Ipsum placeholder text by paragraph, sentence, or word.</li>
            <li><a href="/tools/duplicate-remover">Duplicate Line Remover</a> — Remove duplicate lines from lists, exports, and datasets instantly.</li>
            <li><a href="/tools/find-replace">Find & Replace</a> — Find and replace text or patterns with optional regex support.</li>
            <li><a href="/tools/text-to-slug">Text to Slug</a> — Convert titles and headlines into clean, SEO-friendly URL slugs.</li>
            <li><a href="/tools/sort-lines">Sort Lines</a> — Sort text lines alphabetically, numerically, by length, or randomly.</li>
            <li><a href="/tools/whitespace-cleaner">Whitespace Cleaner</a> — Remove extra spaces, trailing whitespace, and normalize blank lines.</li>
            <li><a href="/tools/string-encoder">String Encoder / Decoder</a> — Encode and decode URL, HTML entities, Base64, and Unicode escapes.</li>
            <li><a href="/tools/sql-in-builder">SQL IN Clause Builder</a> — Convert lists of IDs or codes into clean SQL IN clauses instantly.</li>
            <li><a href="/tools/json-formatter">JSON Formatter & Validator</a> — Format, beautify, validate, and minify JSON data with syntax checks.</li>
            <li><a href="/tools/csv-to-json">CSV to JSON Converter</a> — Bidirectional converter between CSV / Excel spreadsheets and JSON.</li>
            <li><a href="/tools/markdown-table-generator">Excel to Markdown Table</a> — Convert Excel, Google Sheets, or CSV cells into Markdown tables.</li>
            <li><a href="/tools/delimiter-converter">List & Delimiter Converter</a> — Convert columns to comma lists, swap delimiters, and wrap items.</li>
          </ul>
        </section>

        <section class="ads-disclosure">
          <h2>How We Stay Free</h2>
          <p>
            {SITE.name} is supported by unobtrusive display advertising provided by Google AdSense. This enables us to maintain, expand, and serve our tool suite free of charge to users around the world.
          </p>
          <p>
            We do not sell user data, use tracking cookies beyond standard analytics, or display intrusive interstitial ads. Our ad placements are clearly labeled and non-deceptive, in compliance with Google's Publisher Policies.
          </p>
        </section>
      </div>
    </main>

    <AdSlot position="bottom" />
    <Footer siteName={SITE.name} siteUrl={SITE.url} />
  </body>
</html>

<style>
  .about-page {
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
  }

  .about-hero {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .about-hero h1 {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-3);
  }

  .hero-lead {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 700px;
    margin-inline: auto;
  }

  .about-content section {
    margin-bottom: var(--space-12);
  }

  .mission-section h2, .ads-disclosure h2 {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-3);
  }

  .mission-section p, .ads-disclosure p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }

  .pillar-card {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .pillar-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }

  .pillar-card h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-2);
  }

  .pillar-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .origin-section h2,
  .tools-section h2 {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-3);
  }

  .origin-section p,
  .tools-section p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-4);
  }

  .tools-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .tools-list li {
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .tools-list li a {
    font-weight: var(--font-weight-semibold);
  }
</style>
